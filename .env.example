# Supabase - Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: enables LLM-refined incident narratives. Without this, the agent
# still fully works using the rule-based checklist/report pipeline.
ANTHROPIC_API_KEY=

# Optional: protects /api/cron/generate-logs from being called by anyone but
# Vercel Cron. Vercel automatically sends this as a Bearer token when set.
CRON_SECRET=
